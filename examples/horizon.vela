lang vela 0.1

use std.epoch
use std.loss
use std.measure
use std.control
use std.path
use std.hint
use std.eval

// Horizon: Twin-Horizon Interval Control.
// Next generation after LeoAware-class OCE.
// Predictive freeze (epoch horizon) + interval chase (packet horizon)
// + dual-gate contract (eval horizon).

controller Horizon {
  compose Detect + SoftReprobe + IntervalBw + PredictiveFreeze + DualGateGuard

  signals:
    epoch: Epoch
    rtt: Sample<ms> @ epoch
    bw: Interval<bps> @ epoch
    delay_ratio: Ratio
    p_ho: Prob

  on Reconfig(e) {
    invalidate min_rtt, bw
    enter Reprobe(cut: 0.58, explore: 1.15 * rtt, fill: 1.85 * rtt)
  }

  on Loss(k) match k {
    Mobility => hold
    Congestive => cut(0.72)
    Unknown => require delay_ratio > 1.35 then cut(0.72) else hold
  }

  when p_ho > 0.55 {
    freeze min_rtt, bw for 1.4 * rtt
    when bw.n >= 2 {
      pace = bw.mid
    }
  }

  // HorizonChase is in the stdlib but not in this compose.
  // Seed-7 ablation: uncapped chase 55 Mbps / 173 ms vs LeoAware 89 / 108.
  // Re-enable only after scripts/ablate_seed7.py is green.
}

path LeoFastHO {
  handover ~ every 12s jitter 4s
  rtt_jump ~ uniform 20ms 90ms
  capacity ~ uniform 20Mbps 120Mbps
  mobility_loss ~ burst p=0.08 window=400ms
}

contract DualGate vs BBRv3approx {
  seeds = [13, 7, 42, 99, 123]
  scenario leo_fast_ho duration 90s
  assert mean(goodput) >= baseline.goodput
  assert mean(p95) <= baseline.p95
  assert terrestrial.goodput >= 77 Mbps
  report ci(0.95), ablation
}
