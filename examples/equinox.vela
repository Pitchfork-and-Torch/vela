lang vela 0.3

use std.epoch
use std.loss
use std.measure
use std.control
use std.path
use std.eval

// Equinox: VELA 0.3. The language, not another cwnd guess.
//
// Equation Group discipline, inverted:
//   no ambient authority, fail-closed kinds, hashed operators, ledger.
// Modern crypto, applied to science:
//   domain-separated SHA-256, merkle of eval rows, receipt binds source.
// Polymorphism, the PL kind:
//   views are first-class compose morphisms. Not self-modifying code.
//
// Packet path is still LeoAware. Writes stay in the stdlib.
// The leap is that a claim without a receipt does not compile as truth.

controller Equinox {
  posture observe
  compose Detect + SoftReprobe + Calendar + IntervalBw
        + WriteBudget + DualGateGuard

  authority { cwnd: 0, pace: 0 }

  signals:
    epoch: Epoch
    rtt: Sample<ms> @ epoch
    bw: Interval<bps> @ epoch
    delay_ratio: Ratio
    p_ho: Prob
    cap: WriteCap<cwnd> @ epoch

  on Reconfig(e) match e {
    RttHop => {
      invalidate min_rtt, bw
      enter Reprobe(cut: 0.58, explore: 1.15 * rtt, fill: 1.85 * rtt)
    }
    Flicker => {
      invalidate min_rtt, bw
      enter Reprobe(cut: 0.58, explore: 1.15 * rtt, fill: 1.85 * rtt)
    }
  }

  on Loss(k) match k {
    Mobility => hold
    Congestive => cut(0.72)
    Unknown => require delay_ratio > 1.35 then cut(0.72) else hold
  }
}

view Observe of Equinox {
  compose Detect + SoftReprobe + Calendar + IntervalBw + DualGateGuard
}

path LeoFastHO {
  handover ~ every 12s jitter 4s
  rtt_jump ~ uniform 20ms 90ms
  capacity ~ uniform 20Mbps 120Mbps
  mobility_loss ~ burst p=0.08 window=400ms
}

contract DualGate vs BBRv3approx {
  seeds = [13, 7, 42, 99, 123]
  scenario leo_fast_ho duration 90s
  assert mean(goodput) >= baseline.goodput
  assert mean(p95) <= baseline.p95
  assert terrestrial.goodput >= 77 Mbps
  report ci(0.95), ablation, receipt
}
